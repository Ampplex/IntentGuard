# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Test mode only. The client refuses any key id that does not begin with
# rzp_test_, so a live key fails at startup rather than at the first charge.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# The key id is safe in a browser and is served to the page by the backend.
# The secret signs and verifies, and must never leave the server.

# AWS Bedrock, an alternative to the Anthropic API for extraction.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct
